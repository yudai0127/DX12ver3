From c4eab0eb3f2c638e3d7d8aa3b44fe16eca99c617 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 26 Jul 2026 13:55:34 +0000
Subject: [PATCH] Give DLSS true linear depth, plus a jitter toggle to isolate
 the shaking

kBufferTypeLinearDepth means view-space Z, but we were writing the ray's hit
distance. The two diverge toward the edges of the screen, and depth is what
DLSS uses to decide whether a pixel existed last frame - a wrong value there
makes it declare disocclusion and drop its history, so every frame falls back
to raw 1-sample noise. Sky pixels were also written at 1e6, far outside the
frustum DLSS was told about; they now use the far plane, passed through the
unused w of the camera position.

Also add a diagnostic switch that renders DLSS frames with no sub-pixel offset.
It splits the remaining instability cleanly: if the image settles with jitter
off, the jitter convention is wrong; if it still moves, the fault is in the
history inputs.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SfcRdgEzpuV52YCuhdR5ty
---
 HLSL/PathTrace.hlsl                        | 25 +++++++++++++++++++---
 SourceCode/Framework/Framework.cpp         |  1 +
 SourceCode/Graphics/RaytracingRenderer.cpp |  6 ++++--
 SourceCode/Graphics/RaytracingRenderer.h   |  7 ++++++
 4 files changed, 34 insertions(+), 5 deletions(-)

diff --git a/HLSL/PathTrace.hlsl b/HLSL/PathTrace.hlsl
index 835ece6..cebfcc4 100644
--- a/HLSL/PathTrace.hlsl
+++ b/HLSL/PathTrace.hlsl
@@ -41,7 +41,7 @@ RWTexture2D<float>              gLinearDepth : register(u7); // primary-hit dist
 cbuffer SceneCB : register(b0)
 {
     row_major float4x4 invViewProj;
-    float4 cameraPos;
+    float4 cameraPos;   // xyz = eye, w = far plane distance
     float4 lightDir;    // direction the light travels toward
     float4 lightColor;
     float4 ambient;
@@ -176,6 +176,23 @@ float2 motionVector(float3 worldPos, uint2 pix, uint2 dim, float2 jit)
     return ppix - (float2(pix) + 0.5f + jit);
 }
 
+//---- linear depth -----------------------------------------------------------
+// DLSS's kBufferTypeLinearDepth means view-space Z: the distance along the
+// camera's forward axis, not the length of the ray. They differ by up to tens
+// of percent toward the edges of the screen, and feeding the ray length makes
+// DLSS misjudge disocclusion there and throw its history away.
+float3 cameraForward()
+{
+    float4 c = mul(float4(0.0f, 0.0f, 1.0f, 1.0f), invViewProj);
+    c /= c.w;
+    return normalize(c.xyz - cameraPos.xyz);
+}
+
+float linearDepthOf(float3 worldPos)
+{
+    return dot(worldPos - cameraPos.xyz, cameraForward());
+}
+
 //---- shadow ray -------------------------------------------------------------
 float traceShadow(float3 origin, float3 L)
 {
@@ -274,7 +291,9 @@ void RayGen()
             : motionVector(origin0 + dir0 * 1e6f, pix, dim, float2(0.0f, 0.0f));
         gNormalRough[pix] = float4(geoN, geoRough);
         gSpecAlbedo[pix] = float4(geoSpec, 1.0f);
-        gLinearDepth[pix] = (geoD > 0.0f) ? geoD : 1e6f; // sky = very far
+        // View-space Z, and the far plane for sky so DLSS never sees a
+        // depth beyond the frustum it was told about.
+        gLinearDepth[pix] = (geoD > 0.0f) ? linearDepthOf(geoPos) : cameraPos.w;
         gOutput[pix] = float4(tonemap(radiance), 1.0f);
         return;
     }
@@ -409,7 +428,7 @@ void RayGen()
         : motionVector(origin0 + dir0 * 1e6f, pix, dim, float2(0.0f, 0.0f));
     gNormalRough[pix] = float4(geoN, geoRough);
     gSpecAlbedo[pix] = float4(geoSpec, 1.0f);
-    gLinearDepth[pix] = (geoD > 0.0f) ? geoD : 1e6f; // sky = very far
+    gLinearDepth[pix] = (geoD > 0.0f) ? linearDepthOf(geoPos) : cameraPos.w;
 
     float3 avg = sum / float(acc + 1u);
     gOutput[pix] = float4(tonemap(avg), 1.0f);
