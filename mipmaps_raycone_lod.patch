From 736e7cbffa707ffbba984227000663a6459f8125 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 26 Jul 2026 14:59:50 +0000
Subject: [PATCH] Generate mipmaps and pick texture LOD from ray cones

Averaging the guide buffers over the frame's samples reduced the crawling but
could not remove it: that only filters the aliasing by the sample count, and
the aliasing itself comes from the textures having no mipmaps at all while the
ray tracer always sampled mip 0. A pixel covering several texels then lands on
a different one each frame, which is most visible through the normal map.

- Texture loading now goes through DirectXTK's ResourceUploadBatch with mip
  generation enabled, for both files and the glTF-embedded images the model's
  materials actually use. The toolkit is already linked as a project reference,
  and it handles the sRGB detail that makes hand-rolled mip generation awkward.
- The closest-hit shader estimates each ray's footprint with a ray cone
  (Akenine-Moller et al.) - the triangle's texel area against its world area,
  widened by distance travelled and grazing angle - and samples base colour,
  normal, metallic-roughness and emissive at that mip instead of mip 0.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SfcRdgEzpuV52YCuhdR5ty
---
 HLSL/PathTrace.hlsl                        |  53 +++++++-
 SourceCode/Graphics/RaytracingRenderer.cpp |   9 +-
 SourceCode/Graphics/Texture.cpp            | 135 +++++++--------------
 3 files changed, 103 insertions(+), 94 deletions(-)

diff --git a/HLSL/PathTrace.hlsl b/HLSL/PathTrace.hlsl
index 3dda206..6afb0c4 100644
--- a/HLSL/PathTrace.hlsl
+++ b/HLSL/PathTrace.hlsl
@@ -46,7 +46,9 @@ cbuffer SceneCB : register(b0)
     float4 lightColor;
     float4 ambient;
     uint4  frame;       // x=rng seed, y=maxDepth, z=accumIndex, w=render mode
-    float4 envParams;   // x=env texture index (-1=none), y=intensity, z=samples/frame
+    // x=env texture index (-1=none), y=intensity, z=samples/frame,
+    // w=angle one pixel subtends (drives ray-cone texture LOD)
+    float4 envParams;
     row_major float4x4 prevViewProj; // previous frame's view-projection
     // x = 1 when prevViewProj is valid; yz = fixed sub-pixel jitter in pixels;
     // w = 1 when that fixed jitter must be used (DLSS supplies its own sequence
@@ -126,6 +128,16 @@ float3 sampleCone(float3 dir, float cosThetaMax, inout uint s)
     return normalize(t * (sinT * cos(phi)) + b * (sinT * sin(phi)) + dir * cosT);
 }
 
+//---- texture LOD ------------------------------------------------------------
+// Completes the ray-cone lambda for a specific texture: the base term is
+// resolution independent, so each texture folds in its own size here.
+float texLod(Texture2D tex, float lodBase)
+{
+    uint w, h;
+    tex.GetDimensions(w, h);
+    return lodBase + 0.5f * log2(max(float(w) * float(h), 1.0f));
+}
+
 //---- GGX specular sampling --------------------------------------------------
 // Importance-sample the *visible* normal distribution (Heitz 2018). Sampling a
 // cone around the mirror direction instead, as this used to, ignores the shape
@@ -580,33 +592,64 @@ void ClosestHit(inout Payload payload,
 
     float3x3 obj2world = (float3x3)ObjectToWorld3x4();
     float3 Ngeom = normalize(mul(obj2world, nObj));
+
+    // ---- texture LOD from the ray's footprint --------------------------
+    // A ray carries no derivatives, so mip 0 would be used everywhere and any
+    // pixel covering more than one texel aliases - badly for normal maps, whose
+    // aliasing turns into shading that changes every frame. Estimate the
+    // footprint with a ray cone (Akenine-Moller et al.): compare the triangle's
+    // area in texels against its area in world space, then widen by how far the
+    // ray travelled and how obliquely it landed.
+    float lodBase;
+    {
+        float3 p0 = mul(obj2world, v0.position);
+        float3 p1 = mul(obj2world, v1.position);
+        float3 p2 = mul(obj2world, v2.position);
+        float worldArea = length(cross(p1 - p0, p2 - p0));
+
+        float2 duv1 = v1.texcoord - v0.texcoord;
+        float2 duv2 = v2.texcoord - v0.texcoord;
+        float uvArea = abs(duv1.x * duv2.y - duv2.x * duv1.y);
+
+        float coneWidth = RayTCurrent() * envParams.w;   // spread angle per pixel
+        float cosTheta = max(abs(dot(Ngeom, WorldRayDirection())), 1e-2f);
+
+        lodBase = 0.5f * log2(max(uvArea, 1e-12f) / max(worldArea, 1e-12f))
+                + log2(max(coneWidth, 1e-6f) / cosTheta);
+    }
+
     float3 N = Ngeom;
     if (gNormalTex >= 0)
     {
         float3 T = normalize(mul(obj2world, tang.xyz));
         T = normalize(T - dot(T, Ngeom) * Ngeom);
         float3 B = cross(Ngeom, T) * tang.w;
-        float3 nT = gTextures[gNormalTex].SampleLevel(gSampler, uv, 0).xyz * 2.0f - 1.0f;
+        float3 nT = gTextures[gNormalTex].SampleLevel(
+                        gSampler, uv, texLod(gTextures[gNormalTex], lodBase)).xyz
+                    * 2.0f - 1.0f;
         nT.xy *= gNormalScale;
         N = normalize(nT.x * T + nT.y * B + nT.z * Ngeom);
     }
 
     float4 base = gBaseColor;
     if (gBaseColorTex >= 0)
-        base *= gTextures[gBaseColorTex].SampleLevel(gSampler, uv, 0);
+        base *= gTextures[gBaseColorTex].SampleLevel(
+                    gSampler, uv, texLod(gTextures[gBaseColorTex], lodBase));
 
     float metallic = gMetallic;
     float roughness = gRoughness;
     if (gMRTex >= 0)
     {
-        float4 mr = gTextures[gMRTex].SampleLevel(gSampler, uv, 0);
+        float4 mr = gTextures[gMRTex].SampleLevel(
+                        gSampler, uv, texLod(gTextures[gMRTex], lodBase));
         roughness *= mr.g;
         metallic *= mr.b;
     }
 
     float3 emissive = gEmissive.rgb;
     if (gEmissiveTex >= 0)
-        emissive *= gTextures[gEmissiveTex].SampleLevel(gSampler, uv, 0).rgb;
+        emissive *= gTextures[gEmissiveTex].SampleLevel(
+                        gSampler, uv, texLod(gTextures[gEmissiveTex], lodBase)).rgb;
 
     payload.albedo = base.rgb;
     payload.normal = N;
diff --git a/SourceCode/Graphics/RaytracingRenderer.cpp b/SourceCode/Graphics/RaytracingRenderer.cpp
index 754ab04..a178350 100644
--- a/SourceCode/Graphics/RaytracingRenderer.cpp
+++ b/SourceCode/Graphics/RaytracingRenderer.cpp
@@ -9,6 +9,7 @@
 #include "Component/ModelRenderer.h"
 #include "Camera/Camera.h"
 #include <cstring>
+#include <cmath>
 
 using namespace DirectX;
 
@@ -1001,7 +1002,13 @@ void RaytracingRenderer::Render(const Camera& camera)
     sc.ambient = camera.ambient;
     sc.ambient.w = exposure; // pass exposure to the tonemapper (ambient.rgb unused)
     const int spp = (samplesPerFrame < 1) ? 1 : (samplesPerFrame > 8 ? 8 : samplesPerFrame);
-    sc.envParams = XMFLOAT4((float)m_envTexIndex, envIntensity, (float)spp, 0.0f);
+    // .w is the angle a single pixel subtends, which the closest-hit shader
+    // turns into a ray-cone footprint to pick a texture mip level.
+    const float spreadAngle =
+        2.0f * tanf(XMConvertToRadians(camera.fovDegree) * 0.5f) /
+        (float)m_renderHeight;
+    sc.envParams = XMFLOAT4((float)m_envTexIndex, envIntensity, (float)spp,
+                            spreadAngle);
     sc.prevViewProj = m_prevViewProj;
 
     // Under DLSS the whole frame is rendered with one known sub-pixel offset
