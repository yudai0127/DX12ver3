+            device, upload, filename,
+            m_texture.ReleaseAndGetAddressOf(), true);
+
+    upload.End(command.GetQueue()).wait();
 
     if (FAILED(hr) || !m_texture)
     {
@@ -191,60 +183,6 @@ bool Texture::Load(const wchar_t* filename)
     m_width = static_cast<uint32_t>(texDesc.Width);
     m_height = texDesc.Height;
 
-    // ---- 2. アップロード用バッファを作る ----------------------------
-    const UINT64 uploadSize = CalcUploadSize(
-        device, m_texture.Get(), static_cast<UINT>(subresources.size()));
-
-    D3D12_HEAP_PROPERTIES uploadHeap = {};
-    uploadHeap.Type = D3D12_HEAP_TYPE_UPLOAD;
-
-    D3D12_RESOURCE_DESC bufDesc = {};
-    bufDesc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
-    bufDesc.Width = uploadSize;
-    bufDesc.Height = 1;
