     assert(device);
 
-    // ---- 1. 画像を読み込む（拡張子で DDS / WIC を切り替え）-----------
-    std::unique_ptr<uint8_t[]>          imageData;
-    std::vector<D3D12_SUBRESOURCE_DATA> subresources;
-    HRESULT hr = S_OK;
+    // ---- 1-4. 読み込み・転送・ミップ生成 ------------------
